{
  "name": "merecemeuvoto-site",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "¿Merece Meu Voto? — a pausa antes do voto. Comparador de fatos dos candidatos, com fonte em cada card.",
  "author": "Gabriel Albrecht Fitarelli",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://merecemeuvoto.com.br",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validar": "python3 scripts/validar_dados.py",
    "testes": "python3 -m unittest discover -s scripts/tests -p \"test_*.py\"",
    "hooks": "bash scripts/instalar_hooks.sh"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
